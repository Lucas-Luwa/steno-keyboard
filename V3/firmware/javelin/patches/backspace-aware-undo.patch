+bool StenoEngine::IsTrackableManualText(const StenoKeyCodeBuffer &buffer) {
+  for (size_t i = 0; i < buffer.GetCount(); ++i) {
+    const StenoKeyCode code = buffer.buffer[i];
+    // Control keys, newlines and Unicode can change the caret or have host-
+    // dependent deletion behavior. Restrict character accounting to ASCII text.
+    if (code.IsRawKeyCode() || code.GetUnicode() < 32 ||
+        code.GetUnicode() > 126) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void StenoEngine::BreakManualUndoHistory() {
+  ResetState();
+  manualUndoBoundary = true;
+}
+
+void StenoEngine::CommitManualBackspaces() {
+  if (!manualBackspaceCount) {
+    return;
+  }
+  // Starting a new outline commits the edited text: never reconstruct deleted
+  // letters as part of the next word, suffix or retroactive transformation.
+  const StenoState persistentState = state.GetPersistentState();
+  bool joinNext = true;
+  if (history.IsNotEmpty()) {
+    // Use the same bounded tail as normal translation, rather than rendering
+    // all 256 retained strokes into the fixed-size key-code buffer.
+    const size_t conversionCount =
+        history.GetCount() - GetStartingStrokeForNormalModeProcessing();
+    StenoSegmentList segments(conversionCount);
+    BuildSegmentContext context(segments, *this);
+    CreateSegments(context, history.GetCount(), nextConversionBuffer,
+                   conversionCount, segments);
+    ConvertText(nextConversionBuffer.keyCodeBuffer, segments, 0,
+                nextConversionBuffer.segmentBuilder.GetStartingStrokeId(), false);
+    const StenoKeyCodeBuffer &text = nextConversionBuffer.keyCodeBuffer;
+    if (IsTrackableManualText(text) && manualBackspaceCount < text.GetCount()) {
+      joinNext = text.buffer[text.GetCount()-manualBackspaceCount-1].IsSpace();
+    }
+  }
+  BreakManualUndoHistory();
+  state = persistentState;
+  state.joinNext = joinNext;
+  state.isGlue = false;
+}
+
+bool StenoEngine::ApplyManualBackspaces(StenoKeyCodeBuffer &previous,
+                                       const StenoKeyCodeBuffer &next) {
+  if (!manualBackspaceCount) {
+    return true;
+  }
+  if (manualBackspaceCount > previous.GetCount() ||
+      !IsTrackableManualText(previous) || !IsTrackableManualText(next)) {
+    // Manual editing crossed the reconstructable tail. Keep the visible edit
+    // and stop undo at this boundary instead of deleting older characters.
+    BreakManualUndoHistory();
+    return false;
+  }
+  previous.currentOutput -= manualBackspaceCount;
+  manualBackspaceCount = 0;
+  return true;
+}
 
